<Window x:Class="QuickTranslate.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首选项 - QuickTranslate"
        Height="670" Width="830"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="首选项" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="配置 OpenAI 兼容接口、全局热键与常规行为，保存后立即生效。"
                       Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- ================= 热键 ================= -->
            <TabItem Header="热键">
                <Grid Margin="18,16,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintTextStyle}" Margin="2,0,0,12"
                               Text="点击“热键”列的输入框，按下新的组合键即可记录（需至少一个修饰键），系统全局生效。打开本窗口期间全局热键会暂时停用，关闭后自动恢复。"/>

                    <Grid Grid.Row="1" Margin="11,0,11,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="138"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="动作" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="2" Text="目标语言" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="3" Text="热键" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="4" Text="提示词" Foreground="#FF6E8CAD" FontSize="11.5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="启用" Foreground="#FF6E8CAD" FontSize="11.5"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                                  Padding="0,0,4,0">
                        <StackPanel x:Name="HotkeysPanel"/>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="＋ 添加热键" Width="118" Height="30"
                            HorizontalAlignment="Left" Click="AddHotkey_Click"/>
                </Grid>
            </TabItem>

            <!-- ================= API 设置 ================= -->
            <TabItem Header="API 设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel Margin="18,16,18,18">
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,16"
                                   Text="支持任意 OpenAI 兼容接口：OpenAI、DeepSeek、通义千问、智谱、Ollama 等，修改接口地址即可切换。"/>

                        <TextBlock Text="接口地址 (Base URL)" Style="{StaticResource SectionTextStyle}"/>
                        <TextBox x:Name="BaseUrlBox" Margin="0,0,0,14"/>

                        <TextBlock Text="API Key" Style="{StaticResource SectionTextStyle}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <PasswordBox x:Name="ApiKeyBox"/>
                                <TextBox x:Name="ApiKeyText" Visibility="Collapsed"/>
                            </Grid>
                            <CheckBox Grid.Column="1" x:Name="ShowKeyCheck" Content="显示"
                                      VerticalAlignment="Center" Margin="10,0,0,0"
                                      Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/>
                        </Grid>

                        <TextBlock Text="模型" Style="{StaticResource SectionTextStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ModelBox" IsEditable="True"/>
                            <Button x:Name="FetchModelsBtn" Grid.Column="1" Content="获取模型列表"
                                    MinWidth="122" Height="30" Margin="8,0,0,0"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTip="从接口 GET /models 拉取可用模型并填入下拉列表"
                                    Click="FetchModels_Click"/>
                        </Grid>
                        <TextBlock x:Name="ModelStatus" Style="{StaticResource HintTextStyle}" Margin="0,0,0,14"
                                   Text="点击「获取模型列表」可从接口拉取可用模型（需先填好接口地址与 API Key）；也可直接手动输入模型名。"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                <TextBlock Text="温度 (Temperature)" Style="{StaticResource SectionTextStyle}"/>
                                <Slider x:Name="TempSlider" Minimum="0" Maximum="1.5" Value="0.3"
                                        TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TempLabel" VerticalAlignment="Bottom"
                                       Foreground="#FF4A8CF7" FontWeight="SemiBold" Margin="4,0,0,4"/>
                            <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                <TextBlock Text="最大输出 Token" Style="{StaticResource SectionTextStyle}"/>
                                <TextBox x:Name="MaxTokensBox"
                                         ToolTip="只限制模型「输出」的长度（max_tokens），与输入长度无关"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="超时（秒）" Style="{StaticResource SectionTextStyle}"/>
                                <TextBox x:Name="TimeoutBox"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,6,0,0"
                                   Text="「最大输出 Token」只限制模型生成内容的长度（对应接口参数 max_tokens），不影响能发送多少输入文字。思考型模型会把一部分 token 用在思考上，建议留足余量（≥1024）。"/>

                        <TextBlock Text="图片翻译方式" Style="{StaticResource SectionTextStyle}" Margin="0,18,0,0"/>
                        <StackPanel Margin="0,2,0,0">
                            <RadioButton x:Name="ImgVisionRadio" GroupName="ImgMode"
                                         Content="发送原图给视觉模型（推荐，需要支持图片的模型）"/>
                            <RadioButton x:Name="ImgOcrRadio" GroupName="ImgMode" Margin="0,8,0,0"
                                         Content="先本地 OCR 识别文字，再翻译（任意模型可用）"/>
                        </StackPanel>

                        <Border Background="{StaticResource CardSoftBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="连接测试" Style="{StaticResource SectionTextStyle}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TestBtn" Content="测试连接" Width="104" Height="30" Click="Test_Click"/>
                                    <TextBlock x:Name="TestStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Style="{StaticResource HintTextStyle}" MaxWidth="520"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 通用 ================= -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel Margin="18,16,18,18">
                        <CheckBox x:Name="AutoStartBox" Content="开机自动启动（后台运行）" Margin="0,0,0,16"/>

                        <CheckBox x:Name="SkipReasoningBox" Content="翻译时关闭思考（不思考、直出译文，更快更省 token；生成回复仍保留思考）"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="27,6,0,18" TextWrapping="Wrap"
                                   Text="会在请求里带上 thinking.type=disabled（DeepSeek 等支持）；接口不认这个参数时程序会自动去掉它重试，兼容性不受影响。"/>

                        <TextBlock Text="弹窗位置" Style="{StaticResource SectionTextStyle}"/>
                        <ComboBox x:Name="PosBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="优先显示在选中内容上方"/>
                            <ComboBoxItem Content="自动（上方空间不足时显示在下方）"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                   Text="生成回复的语言由各热键自己的「目标语言」决定（该热键没设语言时跟随原文语言），已不再需要单独的全局设置。各功能的默认系统提示词在「提示词」标签页；每个热键也可单独设置自己的提示词。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 提示词 ================= -->
            <TabItem Header="提示词">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel Margin="18,16,18,18">
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="这里为三种功能设置默认系统提示词，留空即使用内置默认。优先级：热键单独设置的提示词 &gt; 这里的功能默认 &gt; 内置默认。若要“一条热键专门用来回邮件”，可在「热键」页给那条热键单独设置提示词。"/>

                        <TextBlock Text="翻译提示词" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="用于「翻译」动作（含图片翻译）。可写清目标语言、术语或语气要求；留空时内置提示词会自动按目标语言翻译并保留原格式。"/>
                        <TextBox x:Name="TranslatePromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                        <TextBlock Text="生成回复提示词" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="用于「生成回复」动作。例如邮件场景可写：你是我的邮件助理，用简洁专业的中文回复，先致谢再给出结论，结尾署名。"/>
                        <TextBox x:Name="ReplyPromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                        <TextBlock Text="截图翻译提示词" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="用于「截图翻译」动作（框选区域 → OCR/视觉模型 → 翻译）。可要求保留排版、忽略界面按钮文字等。"/>
                        <TextBox x:Name="ScreenshotPromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,2,0">
            <Button x:Name="SaveBtn" Content="保存" Width="96" Height="32"
                    Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
            <Button Content="取消" Width="96" Height="32" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
