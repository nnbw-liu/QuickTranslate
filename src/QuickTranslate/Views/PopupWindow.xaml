<Window x:Class="QuickTranslate.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslate"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        ShowActivated="False"
        Focusable="True"
        MinWidth="380"
        MaxWidth="880"
        MaxHeight="680"
        Style="{StaticResource AppWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="Card"
            CornerRadius="14"
            Background="#FAFBFDFF"
            BorderBrush="#FFC9DDF6"
            BorderThickness="1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.30" Color="#FF3B6FA8"/>
        </Border.Effect>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="复制结果" Click="CopyResult_Click"/>
                <MenuItem Header="复制原文" Click="CopyOriginal_Click"/>
                <Separator/>
                <MenuItem Header="翻译为中文" Click="TranslateTo_Click" Tag="中文"/>
                <MenuItem Header="翻译为英文" Click="TranslateTo_Click" Tag="English"/>
                <MenuItem Header="翻译为日语" Click="TranslateTo_Click" Tag="日本語"/>
                <MenuItem Header="重新翻译" Click="Retranslate_Click"/>
                <MenuItem Header="生成回复" Click="Reply_Click"/>
                <MenuItem Header="截图翻译" Click="Ocr_Click"/>
                <Separator/>
                <MenuItem Header="关闭 (Esc)" Click="Close_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Width="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="16,12,10,2">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1E3550" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Margin="10,0,0,0" FontSize="11.5"
                               Foreground="#9BB2CB" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseButton" Content="✕" Width="26" Height="26"
                        HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                        FontSize="12" Click="Close_Click" ToolTip="关闭 (Esc)"/>
            </Grid>

            <ProgressBar x:Name="Busy" Grid.Row="1" Height="3" Margin="16,0,16,2"
                         IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- 内容区：横向滚动必须禁用，否则 ScrollViewer 会以无限宽度测量子元素，TextWrapping 失效（长文本不换行） -->
            <ScrollViewer x:Name="Scroll" Grid.Row="2" MaxHeight="460" Margin="16,2,16,6"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="True">
                <StackPanel>
                    <Expander x:Name="OriginalExpander" Header="原文" IsExpanded="False"
                              Visibility="Collapsed" Foreground="#6E8CAD" FontSize="11.5">
                        <TextBox x:Name="OriginalText" TextWrapping="Wrap" Foreground="#6E8CAD"
                                 FontSize="12" Margin="0,6,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Padding="0" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Disabled"/>
                    </Expander>
                    <StackPanel x:Name="ReasoningPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="思考过程" FontSize="11" FontWeight="SemiBold" Foreground="#9BB2CB"/>
                        <TextBox x:Name="ReasoningText" TextWrapping="Wrap" FontSize="12" Foreground="#7C8A9B"
                                 Margin="0,4,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                 Padding="0" BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                    <TextBox x:Name="ResultText" TextWrapping="Wrap" FontSize="13.5"
                             Foreground="#111827" Margin="0,4,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Padding="0" BorderThickness="0" Background="Transparent"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部操作栏 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="14,0,14,12">
                <Button x:Name="CopyBtn" Content="复制" Padding="10,4" Click="CopyResult_Click"/>
                <Button x:Name="RetranslateBtn" Content="重新翻译" Padding="10,4" Margin="6,0,0,0" Click="Retranslate_Click"/>
                <Button x:Name="ReplyBtn" Content="生成回复" Padding="10,4" Margin="6,0,0,0" Click="Reply_Click"/>
                <Button x:Name="OcrBtn" Content="截图翻译" Padding="10,4" Margin="6,0,0,0" Click="Ocr_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="HintText" Text="右键更多操作 · Esc 关闭" FontSize="10.5"
                           Foreground="#9BB2CB" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
