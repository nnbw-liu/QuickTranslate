<Window x:Class="SDemo.QuickTranslate.Views.InputTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入翻译 - SDemo.QuickTranslate"
        Width="660" Height="500" MinWidth="520" MinHeight="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindowStyle}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border x:Name="Card"
            CornerRadius="14"
            Background="#FAFBFDFF"
            BorderBrush="#FFC9DDF6"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.30" Color="#FF3B6FA8"/>
        </Border.Effect>

        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动窗口） -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Text="输入翻译" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1E3550" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Margin="10,0,0,0" FontSize="11.5"
                               Foreground="#9BB2CB" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ModelText" Margin="10,0,0,0" FontSize="10.5"
                               Foreground="#FFA9BBD0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="7,2" VerticalAlignment="Center"
                            Margin="0,0,8,0" ToolTip="本窗口始终置顶（Topmost），不会被其它窗口遮挡">
                        <TextBlock Text="📌 始终置顶" FontSize="10.5" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <Button x:Name="CloseButton" Content="✕" Width="26" Height="26"
                            Style="{StaticResource IconButtonStyle}" FontSize="12"
                            Click="Close_Click" ToolTip="关闭 (Esc，同时中断正在进行的推理)"/>
                </StackPanel>
            </Grid>

            <ProgressBar x:Name="Busy" Grid.Row="1" Height="3" Margin="0,8,0,0"
                         IsIndeterminate="True" Visibility="Collapsed"/>

            <!-- 目标语言 -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="翻译为" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <ComboBox x:Name="LangBox" Grid.Column="1" Width="190" Margin="8,0,0,0" IsEditable="True"
                          VerticalContentAlignment="Center"
                          ToolTip="选择或直接输入目标语言（如 中文 / English / 日本語）"/>
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           FontSize="11" Foreground="#9BB2CB"
                           Text="Ctrl+Enter 翻译 · Esc 关闭并中断推理 · 可拖动标题栏移动窗口"/>
            </Grid>

            <!-- 输入 -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="要翻译的内容" Style="{StaticResource SectionTextStyle}" Margin="0,0,0,4"/>
                <TextBox x:Name="InputBox" Height="104" VerticalContentAlignment="Top"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Padding="8,6" ToolTip="输入（或粘贴）要翻译的文字，然后按 Ctrl+Enter 或点「翻译」"/>
            </StackPanel>

            <!-- 操作 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="TranslateBtn" Content="翻译 (Ctrl+Enter)" MinWidth="142" Height="30"
                        Style="{StaticResource AccentButtonStyle}" Click="Translate_Click"/>
                <Button x:Name="CopyBtn" Content="复制译文" MinWidth="82" Height="30" Margin="8,0,0,0"
                        IsEnabled="False" Click="CopyResult_Click"/>
                <Button x:Name="ClearBtn" Content="清空" MinWidth="66" Height="30" Margin="8,0,0,0"
                        Click="Clear_Click"/>
                <Button x:Name="CloseBtn" Content="关闭 (Esc)" MinWidth="88" Height="30" Margin="8,0,0,0"
                        Click="Close_Click"/>
            </StackPanel>

            <!-- 译文 / 思考过程 -->
            <Border Grid.Row="5" Margin="0,12,0,0" CornerRadius="9" Padding="10,8"
                    Background="{StaticResource CardSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 思考过程：没有思考内容时整块隐藏；有内容时点标题左侧箭头可收起。 -->
                        <Expander x:Name="ReasoningPanel" Visibility="Collapsed"
                                  IsExpanded="True" Foreground="#9BB2CB">
                            <Expander.Header>
                                <TextBlock x:Name="ReasoningHeader" Text="思考过程（实时）"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9BB2CB"/>
                            </Expander.Header>
                            <TextBox x:Name="ReasoningText" TextWrapping="Wrap" FontSize="12" Foreground="#7C8A9B"
                                     Margin="0,4,0,0" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     Padding="0" BorderThickness="0" Background="Transparent"
                                     VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                        </Expander>
                        <TextBox x:Name="ResultText" TextWrapping="Wrap" FontSize="13.5" AcceptsReturn="True"
                                 Foreground="#111827" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                 Padding="0" BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 提示条：例如「已达到最大输出 Token 上限」，流结束后依然保留 -->
            <StackPanel Grid.Row="6">
                <TextBlock x:Name="NoticeText" Visibility="Collapsed" TextWrapping="Wrap"
                           Margin="0,8,0,0" FontSize="11" Foreground="#FFB26B00"/>
                <TextBlock x:Name="HintText" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10.5" Foreground="#9BB2CB"
                           Text="提示：翻译过程中按 Esc（或点「停止」）会立刻中断本次推理并关闭窗口。"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
