<Window x:Class="SDemo.QuickTranslate.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首选项 - SDemo.QuickTranslate"
        Height="760" Width="1000"
        MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}">

    <Window.Resources>
        <!-- 左侧导航分组标题 -->
        <Style x:Key="NavGroupTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10,14,0,6"/>
        </Style>

        <!-- 左侧导航项（单选按钮当导航用） -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,7"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 提供商卡片上的小按钮 -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        </Style>

        <Style x:Key="RemoveCardButtonStyle" TargetType="Button"
               BasedOn="{StaticResource CardActionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFC42B1C"/>
                    <Setter Property="BorderBrush" Value="#FFF0B6B0"/>
                    <Setter Property="Background" Value="#FFFFF4F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 虚线「添加模型提供商」 -->
        <Style x:Key="AddProviderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="Dash" Fill="{StaticResource CardSoftBrush}"
                                       Stroke="{StaticResource LineBrush}" StrokeThickness="1"
                                       StrokeDashArray="4 3" RadiusX="10" RadiusY="10"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dash" Property="Fill" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource AccentBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Dash" Property="Fill" Value="{StaticResource AccentSoftHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= 左侧：标题 + 导航 ================= -->
            <Border Grid.Column="0" Background="{StaticResource CardSoftBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="20,20,18,8">
                        <TextBlock Text="首选项" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,5,0,0"
                                   Text="配置 OpenAI 兼容接口、全局热键与常规行为。"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="10,2,10,10">
                            <TextBlock Text="基础" Style="{StaticResource NavGroupTextStyle}"/>
                            <RadioButton x:Name="NavHotkeys" Content="热键" Style="{StaticResource NavItemStyle}"
                                         GroupName="PrefNav" Tag="hotkeys" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavModels" Content="模型" Style="{StaticResource NavItemStyle}"
                                         GroupName="PrefNav" Tag="models" Checked="Nav_Checked"/>

                            <TextBlock Text="偏好" Style="{StaticResource NavGroupTextStyle}"/>
                            <RadioButton x:Name="NavGeneral" Content="通用" Style="{StaticResource NavItemStyle}"
                                         GroupName="PrefNav" Tag="general" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavPrompts" Content="提示词" Style="{StaticResource NavItemStyle}"
                                         GroupName="PrefNav" Tag="prompts" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Style="{StaticResource HintTextStyle}" Margin="20,10,18,16"
                               Text="打开首选项期间全局热键暂停，关闭后恢复。"/>
                </Grid>
            </Border>

            <!-- ================= 右侧：分区标题 + 内容 ================= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                        Padding="26,18,26,12">
                    <StackPanel>
                        <TextBlock x:Name="SectionTitle" Style="{StaticResource TitleTextStyle}"/>
                        <TextBlock x:Name="SectionSummary" Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">

                    <!-- ================= 热键 ================= -->
                    <Grid x:Name="HotkeysSection" Margin="24,16,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource HintTextStyle}" Margin="2,0,0,12" TextWrapping="Wrap"
                                   Text="点击“热键”列的输入框，按下新的组合键即可记录（需至少一个修饰键），系统全局生效。打开本窗口期间全局热键会暂时停用，关闭后自动恢复。「输入翻译」动作会弹出置顶输入框，填入内容后翻译，Esc 关闭并中断推理；此时“目标语言”是输入框里预选的语言（留空 = 用上次用过的语言）。“模型”按钮可给这条热键单独指定 API 与模型（不设则用「模型」页里该功能的模型）。"/>

                        <Grid Grid.Row="1" Margin="11,0,11,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="122"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="28"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="名称" Foreground="#FF6E8CAD" FontSize="11.5"/>
                            <TextBlock Grid.Column="1" Text="动作" Foreground="#FF6E8CAD" FontSize="11.5"/>
                            <TextBlock Grid.Column="2" Text="目标语言" Foreground="#FF6E8CAD" FontSize="11.5"/>
                            <TextBlock Grid.Column="3" Text="热键" Foreground="#FF6E8CAD" FontSize="11.5"/>
                            <TextBlock Grid.Column="4" Text="提示词" Foreground="#FF6E8CAD" FontSize="11.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="模型" Foreground="#FF6E8CAD" FontSize="11.5"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="启用" Foreground="#FF6E8CAD" FontSize="11.5"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                                      Padding="0,0,4,0">
                            <StackPanel x:Name="HotkeysPanel"/>
                        </ScrollViewer>

                        <Button Grid.Row="3" Content="＋ 添加热键" Width="118" Height="30"
                                HorizontalAlignment="Left" Click="AddHotkey_Click"/>
                    </Grid>

                    <!-- ================= 模型 ================= -->
                    <Grid x:Name="ModelsSection" Margin="24,16,24,18" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 默认模型 -->
                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="默认模型" Style="{StaticResource SectionTextStyle}"/>
                                <TextBlock Style="{StaticResource HintTextStyle}"
                                           Text="所有没有单独指定模型的请求都用它；某条热键想用别的模型时，在那条热键上点「模型」单独指定（热键模型 &gt; 默认模型）。"/>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                    <ComboBox x:Name="DefaultApiBox" Width="220"
                                              VerticalContentAlignment="Center" SelectionChanged="DefaultApi_Changed"
                                              ToolTip="默认模型使用哪个提供商"/>
                                    <ComboBox x:Name="DefaultModelBox" Width="260" Margin="10,0,0,0"
                                              IsEditable="True" VerticalContentAlignment="Center"
                                              SelectionChanged="DefaultModel_Changed" LostFocus="DefaultModel_LostFocus"
                                              ToolTip="可选列表里的模型，也可以直接输入模型名"/>
                                </StackPanel>
                                <TextBlock x:Name="DefaultModelHint" Style="{StaticResource HintTextStyle}"
                                           Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- 模型提供商卡片 -->
                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,14,16,14"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="模型提供商" Style="{StaticResource SectionTextStyle}"/>
                                    <TextBlock Style="{StaticResource HintTextStyle}"
                                               Text="只支持标准 OpenAI API（GET /v1/models、POST /v1/chat/completions）。"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                    <StackPanel>
                                        <ItemsControl x:Name="ProviderCards">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardSoftBrush}"
                                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                                            CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                    <Border Background="{StaticResource CardBrush}"
                                                                            BorderBrush="{StaticResource LineBrush}"
                                                                            BorderThickness="1" CornerRadius="5"
                                                                            Padding="5,1" Margin="8,0,0,0"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ShortId}" FontSize="10.5"
                                                                                   Foreground="{StaticResource SubtleTextBrush}"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding BaseUrl}" Margin="0,4,0,0"
                                                                           FontSize="11.5"
                                                                           Foreground="{StaticResource SubtleTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding ModelsText}" Margin="0,4,0,0"
                                                                           FontSize="11.5"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           Opacity="0.85"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Top">
                                                                <Button Content="编辑" Tag="{Binding}"
                                                                        Style="{StaticResource CardActionButtonStyle}"
                                                                        Click="EditProvider_Click"/>
                                                                <Button Content="移除" Tag="{Binding}" Margin="6,0,0,0"
                                                                        Style="{StaticResource RemoveCardButtonStyle}"
                                                                        Click="RemoveProvider_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border x:Name="ProviderEmpty" Background="{StaticResource CardSoftBrush}"
                                                CornerRadius="10" Padding="22,18" Margin="0,2,0,0">
                                            <StackPanel>
                                                <TextBlock Text="还没有模型提供商。" FontWeight="SemiBold"
                                                           FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="添加后即可在聊天里选择模型。"
                                                           Style="{StaticResource HintTextStyle}"
                                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Button Grid.Row="2" x:Name="AddProviderBtn" Content="＋ 添加模型提供商"
                                        Margin="0,10,0,0" Style="{StaticResource AddProviderButtonStyle}"
                                        Click="AddProvider_Click"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= 通用 ================= -->
                    <ScrollViewer x:Name="GeneralSection" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel Margin="24,18,24,18">
                            <CheckBox x:Name="AutoStartBox" Content="开机自动启动（后台运行）" Margin="0,0,0,16"/>

                            <CheckBox x:Name="SkipReasoningBox" Content="翻译时关闭思考（不思考、直出译文，更快更省 token；生成回复仍保留思考）"/>
                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="27,6,0,18" TextWrapping="Wrap"
                                       Text="翻译类请求会同时带上四种「关闭思考」参数：thinking.type=disabled（DeepSeek）、enable_thinking=false（通义千问）、chat_template_kwargs.enable_thinking=false（vLLM / llama.cpp）、reasoning_effort=none（LM Studio、OpenAI 风格）。接口通常只认其中一种、忽略其余；若整组都被拒绝（HTTP 400）会自动逐个去掉重试，并把可用的那种记住。若接口完全不支持关闭思考，模型仍会思考——此时思考过程会在浮窗里实时显示，不会让界面干等。"/>

                            <TextBlock Text="弹窗位置" Style="{StaticResource SectionTextStyle}"/>
                            <ComboBox x:Name="PosBox" Margin="0,0,0,16" Width="360" HorizontalAlignment="Left">
                                <ComboBoxItem Content="优先显示在选中内容上方"/>
                                <ComboBoxItem Content="自动（上方空间不足时显示在下方）"/>
                            </ComboBox>

                            <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                       Text="生成回复的语言由各热键自己的「目标语言」决定（该热键没设语言时跟随原文语言）。模型在「模型」页设置：先选一个默认模型，某条热键想用别的模型时在那条热键上点「模型」单独指定（热键模型 > 默认模型）。各功能的默认系统提示词在「提示词」页；每个热键也可单独设置自己的提示词。"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ================= 提示词 ================= -->
                    <ScrollViewer x:Name="PromptsSection" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,6,0">
                        <StackPanel Margin="24,18,24,18">
                            <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                                       Text="这里为三种功能设置默认系统提示词，留空即使用内置默认。优先级：热键单独设置的提示词 &gt; 这里的功能默认 &gt; 内置默认。若要“一条热键专门用来回邮件”，可在「热键」页给那条热键单独设置提示词。"/>

                            <TextBlock Text="翻译提示词" Style="{StaticResource SectionTextStyle}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="用于「翻译」动作（含图片翻译）。可写清目标语言、术语或语气要求；留空时内置提示词会自动按目标语言翻译并保留原格式。"/>
                            <TextBox x:Name="TranslatePromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                            <TextBlock Text="生成回复提示词" Style="{StaticResource SectionTextStyle}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="用于「生成回复」动作。例如邮件场景可写：你是我的邮件助理，用简洁专业的中文回复，先致谢再给出结论，结尾署名。"/>
                            <TextBox x:Name="ReplyPromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                            <TextBlock Text="截图翻译提示词" Style="{StaticResource SectionTextStyle}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="用于「截图翻译」动作（框选区域 → OCR/视觉模型 → 翻译）。可要求保留排版、忽略界面按钮文字等。"/>
                            <TextBox x:Name="ScreenshotPromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- 底部操作 -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                Padding="18,10">
            <Grid>
                <TextBlock Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"
                           Text="保存后立即生效；取消不会写入任何修改。"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveBtn" Content="保存" Width="96" Height="32"
                            Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
                    <Button Content="取消" Width="96" Height="32" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
