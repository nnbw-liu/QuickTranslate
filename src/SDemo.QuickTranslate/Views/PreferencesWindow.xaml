<Window x:Class="SDemo.QuickTranslate.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首选项 - SDemo.QuickTranslate"
        Height="730" Width="830"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource AppWindowStyle}">

    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="2,0,2,12">
            <TextBlock Text="首选项" Style="{StaticResource TitleTextStyle}"/>
            <TextBlock Text="配置 OpenAI 兼容接口、全局热键与常规行为，保存后立即生效。"
                       Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">

            <!-- ================= 热键 ================= -->
            <TabItem Header="热键">
                <Grid Margin="18,16,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintTextStyle}" Margin="2,0,0,12" TextWrapping="Wrap"
                               Text="点击“热键”列的输入框，按下新的组合键即可记录（需至少一个修饰键），系统全局生效。打开本窗口期间全局热键会暂时停用，关闭后自动恢复。「输入翻译」动作会弹出置顶输入框，填入内容后翻译，Esc 关闭并中断推理；此时“目标语言”是输入框里预选的语言（留空 = 用上次用过的语言）。“模型”按钮可给这条热键单独指定 API 与模型（不设则用「模型」页里该功能的模型）。"/>

                    <Grid Grid.Row="1" Margin="11,0,11,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="名称" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="1" Text="动作" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="2" Text="目标语言" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="3" Text="热键" Foreground="#FF6E8CAD" FontSize="11.5"/>
                        <TextBlock Grid.Column="4" Text="提示词" Foreground="#FF6E8CAD" FontSize="11.5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="模型" Foreground="#FF6E8CAD" FontSize="11.5"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="启用" Foreground="#FF6E8CAD" FontSize="11.5"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                                  Padding="0,0,4,0">
                        <StackPanel x:Name="HotkeysPanel"/>
                    </ScrollViewer>

                    <Button Grid.Row="3" Content="＋ 添加热键" Width="118" Height="30"
                            HorizontalAlignment="Left" Click="AddHotkey_Click"/>
                </Grid>
            </TabItem>

            <!-- ================= 模型（多 API + 默认/功能级选择） ================= -->
            <TabItem x:Name="ModelsTab" Header="模型">
                <Grid Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{StaticResource HintTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="可同时配置多个 OpenAI 兼容 API（各有地址 / Key / 模型 / 参数），并选定一个「默认模型」；想换模型的单条热键，在「热键」页点那行的「模型」单独指定。"/>

                    <!-- API 列表 + 选中 API 的详情 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="186"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource CardSoftBrush}"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10,10,10,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="API 列表" Style="{StaticResource SectionTextStyle}"/>
                                <ListBox x:Name="ProviderList" Grid.Row="1" MinHeight="180"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Top"
                                         SelectionChanged="ProviderList_SelectionChanged"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="AddProviderBtn" Content="＋ 添加" Height="28" Click="AddProvider_Click"
                                            ToolTip="新增一个 API（参数沿用当前选中的 API）"/>
                                    <Button x:Name="DelProviderBtn" Content="删除" Height="28" Margin="6,0,0,0"
                                            Click="DeleteProvider_Click" ToolTip="删除当前选中的 API"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                            <StackPanel x:Name="ProviderDetailPanel">
                                <!-- 名称 + 接口地址 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="168"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="名称" Style="{StaticResource SectionTextStyle}"/>
                                        <TextBox x:Name="ProviderNameBox" TextChanged="ProviderField_Changed"
                                                 ToolTip="只用于界面显示与日志，例如 OpenAI / DeepSeek / 本地 LM Studio"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="接口地址 (Base URL)" Style="{StaticResource SectionTextStyle}"/>
                                        <TextBox x:Name="ProviderBaseUrlBox" TextChanged="ProviderField_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="API Key" Style="{StaticResource SectionTextStyle}" Margin="0,10,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <PasswordBox x:Name="ProviderKeyBox" PasswordChanged="ProviderField_Changed"/>
                                        <TextBox x:Name="ProviderKeyText" Visibility="Collapsed" TextChanged="ProviderField_Changed"/>
                                    </Grid>
                                    <CheckBox Grid.Column="1" x:Name="ShowProviderKeyCheck" Content="显示"
                                              VerticalAlignment="Center" Margin="10,0,0,0"
                                              Checked="ShowProviderKey_Changed" Unchecked="ShowProviderKey_Changed"/>
                                </Grid>

                                <!-- 参数：温度 / 最大输出 Token / 超时 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="124"/>
                                        <ColumnDefinition Width="104"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="温度" Style="{StaticResource SectionTextStyle}"/>
                                        <Slider x:Name="ProviderTempSlider" Minimum="0" Maximum="1.5" Value="0.3"
                                                TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                ValueChanged="ProviderTemp_Changed"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" x:Name="ProviderTempLabel" VerticalAlignment="Bottom"
                                               Foreground="#FF4A8CF7" FontWeight="SemiBold"
                                               MinWidth="26" Margin="0,0,16,3"/>
                                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                        <TextBlock Text="最大输出 Token" Style="{StaticResource SectionTextStyle}"/>
                                        <TextBox x:Name="ProviderMaxTokensBox" TextChanged="ProviderField_Changed"
                                                 ToolTip="只限制模型输出长度（max_tokens），思考过程也计入这个额度"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="超时（秒）" Style="{StaticResource SectionTextStyle}"/>
                                        <TextBox x:Name="ProviderTimeoutBox" TextChanged="ProviderField_Changed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 常用模型 + 获取模型列表 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="常用模型" Style="{StaticResource SectionTextStyle}"/>
                                        <ComboBox x:Name="ProviderModelBox" IsEditable="True"
                                                  SelectionChanged="ProviderField_Changed"
                                                  LostFocus="ProviderField_Changed"
                                                  ToolTip="这个 API 下常用/待测的模型：测试连接用它，热键里也会预选它"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="FetchModelsBtn" Content="获取模型列表"
                                            Height="28" MinWidth="118" VerticalAlignment="Bottom"
                                            Style="{StaticResource AccentButtonStyle}"
                                            ToolTip="GET {接口地址}/models 拉取可用模型，填入本 API 的模型列表"
                                            Click="FetchModels_Click"/>
                                </Grid>
                                <TextBlock x:Name="ProviderModelStatus" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="点「获取模型列表」可从接口拉取模型名（需先填好接口地址与 API Key），也可以直接在「常用模型」里手动输入。"/>

                                <!-- 图片翻译方式 + 连接测试 -->
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="图片翻译方式" Style="{StaticResource SectionTextStyle}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <RadioButton Grid.Column="1" x:Name="ProviderImgVisionRadio" GroupName="ProviderImgMode"
                                                 Checked="ProviderField_Changed" VerticalAlignment="Center"
                                                 ToolTip="截图直接发给多模态模型：快、保留排版，但需要模型支持图片"
                                                 Content="发送原图给视觉模型"/>
                                    <RadioButton Grid.Column="2" x:Name="ProviderImgOcrRadio" GroupName="ProviderImgMode"
                                                 Checked="ProviderField_Changed" VerticalAlignment="Center"
                                                 ToolTip="先本地 OCR 识别文字再翻译：任意模型可用"
                                                 Content="先本地 OCR 再翻译"/>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="TestBtn" Content="测试连接" Width="96" Height="30"
                                            VerticalAlignment="Center" Click="Test_Click"/>
                                    <TextBlock Grid.Column="1" x:Name="TestStatus" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 默认模型 -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Background="{StaticResource CardSoftBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="默认模型（选一个 API 和它的模型，所有没单独指定的请求都用它）" Style="{StaticResource SectionTextStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="DefaultApiBox" Width="190" SelectionChanged="DefaultApi_Changed"/>
                                <ComboBox x:Name="DefaultModelBox" Width="250" Margin="8,0,0,0" IsEditable="True"
                                          SelectionChanged="DefaultModel_Changed" LostFocus="DefaultModel_LostFocus"
                                          ToolTip="可选列表里的模型，也可以直接输入模型名"/>
                                <TextBlock x:Name="DefaultModelHint" Style="{StaticResource HintTextStyle}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= 通用 ================= -->
            <TabItem Header="通用">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel Margin="18,16,18,18">
                        <CheckBox x:Name="AutoStartBox" Content="开机自动启动（后台运行）" Margin="0,0,0,16"/>

                        <CheckBox x:Name="SkipReasoningBox" Content="翻译时关闭思考（不思考、直出译文，更快更省 token；生成回复仍保留思考）"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="27,6,0,18" TextWrapping="Wrap"
                                   Text="翻译类请求会同时带上四种「关闭思考」参数：thinking.type=disabled（DeepSeek）、enable_thinking=false（通义千问）、chat_template_kwargs.enable_thinking=false（vLLM / llama.cpp）、reasoning_effort=none（LM Studio、OpenAI 风格）。接口通常只认其中一种、忽略其余；若整组都被拒绝（HTTP 400）会自动逐个去掉重试，并把可用的那种记住。若接口完全不支持关闭思考，模型仍会思考——此时思考过程会在浮窗里实时显示，不会让界面干等。"/>

                        <TextBlock Text="弹窗位置" Style="{StaticResource SectionTextStyle}"/>
                        <ComboBox x:Name="PosBox" Margin="0,0,0,16">
                            <ComboBoxItem Content="优先显示在选中内容上方"/>
                            <ComboBoxItem Content="自动（上方空间不足时显示在下方）"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                   Text="生成回复的语言由各热键自己的「目标语言」决定（该热键没设语言时跟随原文语言）。模型在「模型」页设置：先选一个默认模型，某条热键想用别的模型时在那条热键上点「模型」单独指定（热键模型 > 默认模型）。各功能的默认系统提示词在「提示词」页；每个热键也可单独设置自己的提示词。"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= 提示词 ================= -->
            <TabItem Header="提示词">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <StackPanel Margin="18,16,18,18">
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Text="这里为三种功能设置默认系统提示词，留空即使用内置默认。优先级：热键单独设置的提示词 &gt; 这里的功能默认 &gt; 内置默认。若要“一条热键专门用来回邮件”，可在「热键」页给那条热键单独设置提示词。"/>

                        <TextBlock Text="翻译提示词" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="用于「翻译」动作（含图片翻译）。可写清目标语言、术语或语气要求；留空时内置提示词会自动按目标语言翻译并保留原格式。"/>
                        <TextBox x:Name="TranslatePromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                        <TextBlock Text="生成回复提示词" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="用于「生成回复」动作。例如邮件场景可写：你是我的邮件助理，用简洁专业的中文回复，先致谢再给出结论，结尾署名。"/>
                        <TextBox x:Name="ReplyPromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,0,0,18"/>

                        <TextBlock Text="截图翻译提示词" Style="{StaticResource SectionTextStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Text="用于「截图翻译」动作（框选区域 → OCR/视觉模型 → 翻译）。可要求保留排版、忽略界面按钮文字等。"/>
                        <TextBox x:Name="ScreenshotPromptBox" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部操作 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,2,0">
            <Button x:Name="SaveBtn" Content="保存" Width="96" Height="32"
                    Style="{StaticResource AccentButtonStyle}" Click="Save_Click"/>
            <Button Content="取消" Width="96" Height="32" Margin="10,0,0,0" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
