<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuickTranslate</AssemblyName>
    <!-- 命名空间统一加 SDemo 前缀：SDemo.QuickTranslate / .Models / .Services / .Views / .Native。
         项目名仍是 SDemo.QuickTranslate，可执行文件名（AssemblyName）为 QuickTranslate.exe -->
    <RootNamespace>SDemo.QuickTranslate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.1.0</Version>
    <!-- 署名 / 文件属性统一为 SDemo（Windows「属性 → 详细信息」里的公司、版权） -->
    <AssemblyTitle>SDemo.QuickTranslate 翻译助手</AssemblyTitle>
    <Product>SDemo.QuickTranslate</Product>
    <Company>SDemo</Company>
    <Copyright>Copyright © SDemo</Copyright>
    <Description>后台常驻的托盘翻译工具（WPF + C++ SDemo.NativeCore.dll）。</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 忽略 WinForms 关于 manifest DPI 的提示（本应用以 WPF + manifest 为准） -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 移除隐式全局 using，避免 WinForms/System.Drawing 与 WPF 类型歧义；需要的文件显式引入 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- 将 C++ 原生库复制到输出目录（若已构建） -->
    <None Include="..\SDemo.NativeCore\build\bin\Release\SDemo.NativeCore.dll"
          Link="SDemo.NativeCore.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\SDemo.NativeCore\build\bin\Release\SDemo.NativeCore.dll')" />
  </ItemGroup>

</Project>
